# URL of the backend API (your Render backend service URL)
VITE_API_URL=https://smart-agritech-api.onrender.com

# Optional: Firebase (only needed if you want Google OAuth)
# If left blank, Google Sign-In is disabled and only email/password works
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
